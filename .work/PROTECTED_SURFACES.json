{
  "version": 2,
  "description": "High-blast paths for System News. Override requires owner approval in the same message.",
  "rule": "fail_verify_without_owner_approval",
  "paths": [
    "docker-compose.dev.yml",
    "docker-compose.prd.yml",
    "Caddyfile",
    ".env.example",
    ".cursorrules",
    "apps/api/pyproject.toml",
    "apps/web/package.json",
    "apps/web/pnpm-lock.yaml",
    "apps/web/next.config.ts",
    "apps/web/tsconfig.json",
    "apps/web/postcss.config.mjs",
    ".github/workflows/ci.yml",
    ".github/workflows/deploy.yml"
  ],
  "patterns": [
    ".env.*",
    "*.pem",
    "*.key",
    "**/secrets/**"
  ],
  "thresholds": {
    "max_lines_warn": 150,
    "max_lines_fail": 400,
    "max_areas_warn": 2,
    "max_areas_fail": 3
  }
}
