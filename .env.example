# System News - single environment template (repo root)
# Copy to .env.dev / .env.prd with: ./bin/start.sh init-env --env dev|prd
# Only .env.example is tracked. No service may define its own .env file.

# --- stack identity (matches the dev|prd suffix) ---
COMPOSE_PROJECT_NAME=system-news-dev
STACK_SUFFIX=dev
APP_ENV=dev

# --- public surface ---
# APP_DOMAIN is the apex. With APP_ENV=prd every channel is also served from
# <slug>.APP_DOMAIN, so one value drives the app, nginx and the canonical URLs.
APP_DOMAIN=localhost
# Absolute origin used for canonical/OG URLs when the request host is not
# domain-scoped. Production: https://<APP_DOMAIN>
APP_BASE_URL=http://localhost:3000
# Publish host for the loopback ports nginx proxies to.
API_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
# Caddy host ports (dev/prd only): the stack does not run Caddy itself; set
# these when a host-level Caddy fronts it, leave empty where it does not.
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# --- channel subdomains ---
# Empty = path URLs (/stem-cell). Set to localhost in dev to get
# http://stem-cell.localhost:<WEB_PORT>; prd derives it from APP_DOMAIN.
SN_CHANNEL_DOMAIN=
# Certificate name under /etc/letsencrypt/live/ used by the generated nginx
# sites. One certificate must cover the apex and every channel host.
SSL_CERT_NAME=
# Let's Encrypt account email (expiry notices). Falls back to CONTACT_TO.
ACME_EMAIL=

# --- data ---
POSTGRES_DB=news
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://news:change-me@postgres:5432/news
REDIS_URL=redis://redis:6379/0
# init-env generates this and embeds it in REDIS_URL; keep the two in sync.
REDIS_PASSWORD=

# --- security ---
SECRET_KEY=change-me-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- AI (DeepSeek) ---
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_MONTHLY_BUDGET_USD=20
AI_MAX_ITEMS_PER_RUN=60
REFRESH_INTERVAL_MINUTES=720

# --- crawler identity and pacing (fetch safety) ---
# The user agent every feed request presents. BOT_URL must be a page a
# publisher can actually open; it points at the /bot page in this app.
BOT_NAME=HeraldFoxBot
BOT_VERSION=1.0
BOT_URL=https://heraldfox.com/bot
# enforce = apply the per-host floor, hourly cap and breaker
# shadow  = compute and log them without delaying anything
# off     = no floor/cap/breaker (an explicit Retry-After is still honoured)
FETCH_PACING=enforce
FETCH_HOST_FLOOR_S=5
FETCH_HOST_HOURLY_CAP=20
# robots TTL, breaker thresholds, retry base and cooldown caps keep their
# defaults in apps/api/src/news_api/platform/settings.py.

# --- email (contact/lead notifications) ---
# SMTP_TRANSPORT picks the lane; SMTP_FROM is the sender on every lane.
#   gateway = pilo-mail relay gateway -> Brevo from one fixed IP (live)
#   direct  = pilo-mail submission (Mailu), delivered from the host itself
#   ""      = the flat SMTP_* block below (any provider)
# info@links.heraldfox.com must be in the gateway's sender allow-list
# (/srv/pilo-gateway/config/sender-login-maps.pcre) and its relay map.
SMTP_TRANSPORT=gateway
SMTP_FROM="Herald Fox <info@links.heraldfox.com>"
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_GATEWAY_HOST=smtp.iterwire.com
SMTP_GATEWAY_PORT=2525
SMTP_GATEWAY_USER=heraldfox@relay.iterwire.com
SMTP_GATEWAY_PASSWORD=
SMTP_GATEWAY_SSL=false
SMTP_DIRECT_HOST=mail.iterwire.com
SMTP_DIRECT_PORT=465
SMTP_DIRECT_USER=
SMTP_DIRECT_PASSWORD=
SMTP_DIRECT_SSL=true
# flat lane, only read when SMTP_TRANSPORT is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=news@heraldfox.com

# --- web ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
SN_DEFAULT_LOCALE=en
SN_DEFAULT_INDUSTRY=legal

# --- observability ---
# info: startup, worker cycles, failures (4xx warn, 5xx error) and slow requests.
# debug adds one line per successful request.
LOG_LEVEL=info
# A request slower than this is logged at info even when it succeeded.
LOG_SLOW_REQUEST_MS=1000
METRICS_ENABLED=true
