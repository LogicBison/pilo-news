# System News - single environment template (repo root)
# Copy to .env.dev / .env.prd with: ./bin/start.sh init-env --env dev|prd
# Only .env.example is tracked. No service may define its own .env file.

# --- stack identity (matches the dev|prd suffix) ---
COMPOSE_PROJECT_NAME=system-news-dev
STACK_SUFFIX=dev
APP_ENV=dev

# --- public surface ---
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost:3000
API_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- data ---
POSTGRES_DB=news
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://news:change-me@postgres:5432/news
REDIS_URL=redis://redis:6379/0

# --- security ---
SECRET_KEY=change-me-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- AI (DeepSeek) ---
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_MONTHLY_BUDGET_USD=20
AI_MAX_ITEMS_PER_RUN=60
REFRESH_INTERVAL_MINUTES=720

# --- email (contact/lead notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=news@example.com

# --- web ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
SN_DEFAULT_LOCALE=en
SN_DEFAULT_INDUSTRY=legal

# --- observability ---
LOG_LEVEL=info
METRICS_ENABLED=true
