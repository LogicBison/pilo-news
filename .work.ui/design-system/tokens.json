{
  "color": {
    "text": {
      "primary": {
        "$type": "color",
        "$value": "oklch(21.0% 0.0318 264.7)",
        "$description": "Body and heading text. Measured 17.7:1 on surface.base (#111827).",
        "$extensions": { "sn": { "hex": "#111827" } }
      },
      "secondary": {
        "$type": "color",
        "$value": "oklch(37.3% 0.0306 259.7)",
        "$description": "Supporting copy, card metadata. Measured 10.3:1 on white (#374151).",
        "$extensions": { "sn": { "hex": "#374151" } }
      },
      "muted": {
        "$type": "color",
        "$value": "oklch(44.6% 0.0263 256.8)",
        "$description": "Timestamps, captions, quiet links. Measured 7.6:1 on white (#4b5563).",
        "$extensions": { "sn": { "hex": "#4b5563" } }
      },
      "on-primary": {
        "$type": "color",
        "$value": "oklch(100% 0 0)",
        "$description": "Text on brand.primary fills. Measured 11.5:1 on #1e3a5f.",
        "$extensions": { "sn": { "hex": "#ffffff" } }
      }
    },
    "surface": {
      "base": {
        "$type": "color",
        "$value": "oklch(98.9% 0.0026 286.4)",
        "$description": "Page canvas. Slightly off-white so elevated cards read as raised.",
        "$extensions": { "sn": { "hex": "#fbfbfd" } }
      },
      "elevated": {
        "$type": "color",
        "$value": "oklch(100% 0 0)",
        "$description": "Cards, panels, modals. Pair with elevation.1/2.",
        "$extensions": { "sn": { "hex": "#ffffff" } }
      },
      "inset": {
        "$type": "color",
        "$value": "oklch(96.4% 0.0058 264.5)",
        "$description": "Wells inside cards: input fills, chips, code blocks.",
        "$extensions": { "sn": { "hex": "#f1f3f7" } }
      },
      "overlay": {
        "$type": "color",
        "$value": "oklch(100% 0 0)",
        "$description": "Sheets, popovers, sticky bars above content.",
        "$extensions": { "sn": { "hex": "#ffffff" } }
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "oklch(93.3% 0.0092 258.3)",
        "$description": "Region separators between sections of the same surface.",
        "$extensions": { "sn": { "hex": "#e5e9ef" } }
      },
      "default": {
        "$type": "color",
        "$value": "oklch(89.8% 0.0127 255.5)",
        "$description": "Decorative card and table borders. 1.35:1 on white — never the only affordance for a control.",
        "$extensions": { "sn": { "hex": "#d8dee6" } }
      },
      "strong": {
        "$type": "color",
        "$value": "oklch(59.8% 0.0252 260.7)",
        "$description": "Control boundaries that must pass WCAG 1.4.11. Measured 3.99:1 on white, 3.59:1 on surface.inset.",
        "$extensions": { "sn": { "hex": "#77808f" } }
      }
    },
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "oklch(34.6% 0.0736 256.0)",
        "$description": "Channel primary. Default is the editorial fallback; channels override from data.",
        "$extensions": { "sn": { "hex": "#1e3a5f" } }
      },
      "accent": {
        "$type": "color",
        "$value": "oklch(47.9% 0.1104 58.6)",
        "$description": "Channel accent: eyebrow, CTA card edge, focus ring. Measured 6.79:1 on white.",
        "$extensions": { "sn": { "hex": "#8a4b08" } }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.brand.accent}",
        "$description": "Focus-visible outline. 3px, offset 2px."
      }
    },
    "state": {
      "success": {
        "$type": "color",
        "$value": "oklch(52.7% 0.1371 150.1)",
        "$description": "Confirmation text and icons. Measured 5.02:1 on white.",
        "$extensions": { "sn": { "hex": "#15803d" } }
      },
      "warning": {
        "$type": "color",
        "$value": "oklch(55.5% 0.1455 49.0)",
        "$description": "Degraded / retry notices. Measured 5.02:1 on white.",
        "$extensions": { "sn": { "hex": "#b45309" } }
      },
      "danger": {
        "$type": "color",
        "$value": "oklch(50.5% 0.1905 27.5)",
        "$description": "Field errors, destructive confirmation. Measured 6.47:1 on white.",
        "$extensions": { "sn": { "hex": "#b91c1c" } }
      },
      "info": {
        "$type": "color",
        "$value": "oklch(40.3% 0.0787 233.2)",
        "$description": "Language-fallback notice. Measured 8.94:1 on white.",
        "$extensions": { "sn": { "hex": "#0b4f6c" } }
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "0.25rem", "$description": "4px — hairline gaps inside a control." },
    "2": { "$type": "dimension", "$value": "0.5rem", "$description": "8px — label to input." },
    "3": { "$type": "dimension", "$value": "0.75rem", "$description": "12px — chip padding." },
    "4": { "$type": "dimension", "$value": "1rem", "$description": "16px — default gap between blocks." },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem", "$description": "24px — card padding, section inner spacing." },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem", "$description": "48px — section separation on channel home." },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px", "$description": "Professional layout default." },
    "md": { "$type": "dimension", "$value": "10px", "$description": "Editorial / academic default; matches --sn-radius." },
    "lg": { "$type": "dimension", "$value": "14px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Chips and primary buttons." }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(15, 23, 42, 0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "rgba(15, 23, 42, 0.08)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
      ],
      "$description": "Resting card."
    },
    "2": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(15, 23, 42, 0.07)", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
        { "color": "rgba(15, 23, 42, 0.08)", "offsetX": "0px", "offsetY": "8px", "blur": "20px", "spread": "0px" }
      ],
      "$description": "Hover, sticky bar."
    },
    "3": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(15, 23, 42, 0.14)", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" },
        { "color": "rgba(15, 23, 42, 0.06)", "offsetX": "0px", "offsetY": "4px", "blur": "10px", "spread": "0px" }
      ],
      "$description": "Raised interactive card, mobile CTA bar."
    },
    "inset": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(15, 23, 42, 0.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "inset": true
      },
      "$description": "Well depth for surface.inset blocks."
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Body and UI. No webfont request; LCP stays server-rendered text."
      },
      "serif": {
        "$type": "fontFamily",
        "$value": ["Georgia", "Times New Roman", "serif"],
        "$description": "Editorial and academic headings; also long-form article body option."
      }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem", "$description": "12px — captions, disclaimer." },
      "sm": { "$type": "dimension", "$value": "0.875rem", "$description": "14px — secondary UI text." },
      "base": { "$type": "dimension", "$value": "1rem", "$description": "16px — body floor, never smaller." },
      "lg": { "$type": "dimension", "$value": "1.125rem", "$description": "18px — article lede." },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem", "$description": "24px — card headline." },
      "3xl": { "$type": "dimension", "$value": "1.875rem" },
      "4xl": { "$type": "dimension", "$value": "2.25rem", "$description": "36px — channel-home H1 on desktop." },
      "5xl": { "$type": "dimension", "$value": "3rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 800, "$description": "Brandmark only." }
    },
    "leading": {
      "tight": { "$type": "lineHeight", "$value": 1.15, "$description": "Display headings." },
      "snug": { "$type": "lineHeight", "$value": 1.35, "$description": "Card headlines." },
      "normal": { "$type": "lineHeight", "$value": 1.6, "$description": "Body default (matches body rule)." },
      "relaxed": { "$type": "lineHeight", "$value": 1.75, "$description": "Article body." }
    },
    "tracking": {
      "tight": { "$type": "letterSpacing", "$value": "-0.01em" },
      "normal": { "$type": "letterSpacing", "$value": "0" },
      "wide": { "$type": "letterSpacing", "$value": "0.14em", "$description": "Eyebrow, uppercase labels." },
      "wider": { "$type": "letterSpacing", "$value": "0.16em" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "160ms", "$description": "Color and border changes." },
      "base": { "$type": "duration", "$value": "200ms", "$description": "Card hover, shadow." },
      "slow": { "$type": "duration", "$value": "320ms", "$description": "Sheet and bar entry." }
    },
    "ease": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "Matches --sn-ease." },
      "out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 30, "$description": "App bar." },
    "overlay": { "$type": "number", "$value": 40, "$description": "Mobile CTA bar, popovers." },
    "toast": { "$type": "number", "$value": 50 }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  }
}
