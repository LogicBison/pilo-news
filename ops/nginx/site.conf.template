# System News - nginx site (rendered by `./bin/start.sh --env prd domains --write`)
#
# Do not edit the generated files under ops/nginx/sites/: edit this template and
# re-run the command:
#   ./bin/start.sh --env prd domains --write

# --- canonical redirect ----------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;

    # Let's Encrypt renewals keep using HTTP-01 on this host.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- bootstrap: tls-start ---------------------------------------------------
# Everything between `tls-start` and `tls-end` is stripped by
# `./bin/start.sh --env prd domains --write --http-only`, which is how the first
# certificate gets issued: nginx cannot load a 443 block whose certificate does
# not exist yet, and certbot needs port 80 answering for every host first.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __HOST__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml application/rss+xml;

    # The app resolves the channel from the Host header too; the explicit header
    # is what makes a misconfigured Host safe to reason about.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-SN-Channel __CHANNEL__;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    # Public API. `/api/*` stays on the web app: it is the Next.js proxy that
    # forwards browser calls (funnel events, lead forms) to `/v1/*` server-side.
    location /v1/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
    }

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
    }
}
# --- bootstrap: tls-end -----------------------------------------------------
