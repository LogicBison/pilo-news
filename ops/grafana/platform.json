{
  "title": "System News - platform",
  "uid": "system-news-platform",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / sec",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(http_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate limited",
      "targets": [
        {
          "expr": "sum(rate(rate_limited_total[5m])) by (scope)"
        }
      ]
    }
  ]
}
