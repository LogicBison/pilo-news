{
  "title": "System News - pipeline and AI",
  "uid": "system-news-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Refresh runs",
      "targets": [
        {
          "expr": "sum(rate(refresh_runs_total[1h])) by (trigger,status)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Items in",
      "targets": [
        {
          "expr": "sum(rate(ingest_items_total[1h])) by (industry,result)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Summaries",
      "targets": [
        {
          "expr": "sum(rate(summaries_generated_total[1h])) by (language,status)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI cost (USD)",
      "targets": [
        {
          "expr": "sum(increase(ai_estimated_cost_usd_total[24h])) by (model)"
        }
      ]
    }
  ]
}
